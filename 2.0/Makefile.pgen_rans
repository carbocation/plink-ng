.DEFAULT_GOAL := pgen_rans_codec_test

include Makefile

PGENRANS_BUILD_DIR ?= build_pgen_rans
PGENRANS_OBJ_DIR := $(PGENRANS_BUILD_DIR)/obj
PGENRANS_BIN_DIR := $(PGENRANS_BUILD_DIR)/bin
PGENRANS_LIB_DIR := $(PGENRANS_BUILD_DIR)/lib

PGENRANSCODECOBJ = $(addprefix $(PGENRANS_OBJ_DIR)/,\
	pgen_rans_codec.o pgen_rans_hybrid.o)
PGENRANSTESTOBJ = $(PGENRANSCODECOBJ) \
	$(PGENRANS_OBJ_DIR)/pgen_rans_codec_test.o
PGENRANSHYBRIDTESTOBJ = $(PGENRANSCODECOBJ) \
	$(PGENRANS_OBJ_DIR)/pgen_rans_hybrid_test.o
PGENRANSCONTAINEROBJ = $(addprefix $(PGENRANS_OBJ_DIR)/,\
	pgen_rans_container.o pgen_rans_cpu.o)
PGENRANSLIBOBJ = $(PGENRANSCODECOBJ) $(PGENRANSCONTAINEROBJ) \
	$(addprefix $(PGENRANS_OBJ_DIR)/,\
	pgen_rans_encode.o pgen_rans_reader.o)
PGENRANSCONTAINERTESTOBJ = $(PGENRANSCODECOBJ) \
	$(PGENRANSCONTAINEROBJ) \
	$(addprefix $(PGENRANS_OBJ_DIR)/,\
	pgen_rans_reader.o pgen_rans_container_test.o)
PGENRANSTOOLSRC = $(PGENLIB_CCSRC) pgen_rans_codec.cc pgen_rans_hybrid.cc \
	pgen_rans_container.cc pgen_rans_cpu.cc pgen_rans_encode.cc \
	pgen_rans_tool.cc
PGENRANSTOOLOBJ = $(addprefix $(PGENRANS_OBJ_DIR)/,\
	$(PGENRANSTOOLSRC:.cc=.o))

# The entropy and sparse-predictor hot loops benefit from O3 scheduling.
# Keep the rest of PLINK's flags unchanged.
$(PGENRANS_OBJ_DIR)/pgen_rans_codec.o: CXXFLAGS += -O3
$(PGENRANS_OBJ_DIR)/pgen_rans_hybrid.o: CXXFLAGS += -O3
$(PGENRANS_OBJ_DIR)/pgen_rans_encode.o: CXXFLAGS += -O3

$(PGENRANS_OBJ_DIR)/%.o: %.cc
	$(MKDIR) -p $(dir $@)
	$(CXX) -c $(CXXFLAGS) $(ARCH32) -o $@ $<

.PHONY: libpgen_rans pgen_rans pgen_rans_codec_test pgen_rans_hybrid_test \
	pgen_rans_container_test test

libpgen_rans: $(PGENRANSLIBOBJ)
	$(MKDIR) -p $(PGENRANS_LIB_DIR)
	$(AR) rcs $(PGENRANS_LIB_DIR)/libpgen_rans.a $(PGENRANSLIBOBJ)

pgen_rans: $(PGENRANSTOOLOBJ)
	$(MKDIR) -p $(PGENRANS_BIN_DIR)
	$(CXX) $(PGENRANSTOOLOBJ) \
		-o $(PGENRANS_BIN_DIR)/pgen_rans $(LDFLAGS)

pgen_rans_codec_test: $(PGENRANSTESTOBJ)
	$(MKDIR) -p $(PGENRANS_BIN_DIR)
	$(CXX) $(PGENRANSTESTOBJ) \
		-o $(PGENRANS_BIN_DIR)/pgen_rans_codec_test $(LDFLAGS)

pgen_rans_hybrid_test: $(PGENRANSHYBRIDTESTOBJ)
	$(MKDIR) -p $(PGENRANS_BIN_DIR)
	$(CXX) $(PGENRANSHYBRIDTESTOBJ) \
		-o $(PGENRANS_BIN_DIR)/pgen_rans_hybrid_test $(LDFLAGS)

pgen_rans_container_test: $(PGENRANSCONTAINERTESTOBJ)
	$(MKDIR) -p $(PGENRANS_BIN_DIR)
	$(CXX) $(PGENRANSCONTAINERTESTOBJ) \
		-o $(PGENRANS_BIN_DIR)/pgen_rans_container_test $(LDFLAGS)

test: pgen_rans_codec_test pgen_rans_hybrid_test pgen_rans_container_test
	$(PGENRANS_BIN_DIR)/pgen_rans_codec_test
	$(PGENRANS_BIN_DIR)/pgen_rans_hybrid_test
	$(PGENRANS_BIN_DIR)/pgen_rans_container_test

CLEAN += $(PGENRANSLIBOBJ) $(PGENRANSTOOLOBJ) $(PGENRANSTESTOBJ) \
	$(PGENRANSHYBRIDTESTOBJ) \
	$(PGENRANSCONTAINERTESTOBJ) \
	$(PGENRANS_LIB_DIR)/libpgen_rans.a \
	$(PGENRANS_BIN_DIR)/pgen_rans \
	$(PGENRANS_BIN_DIR)/pgen_rans_codec_test \
	$(PGENRANS_BIN_DIR)/pgen_rans_hybrid_test \
	$(PGENRANS_BIN_DIR)/pgen_rans_container_test
